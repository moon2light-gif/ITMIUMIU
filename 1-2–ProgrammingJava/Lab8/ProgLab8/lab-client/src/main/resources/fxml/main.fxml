<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.ui.MainController">

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="topbar">
        <padding><Insets bottom="10" left="16" right="16" top="10" /></padding>
        <Label fx:id="userInfoLabel" styleClass="user-label" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="logoutButton" onAction="#handleLogout" styleClass="topbar-btn" />
        <MenuButton fx:id="langButton" styleClass="lang-button" text="RU" />
    </HBox>

    <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <Tab fx:id="tableTab">
            <VBox spacing="0">
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="toolbar">
                    <padding><Insets bottom="10" left="16" right="16" top="10" /></padding>
                    <Button fx:id="infoButton" onAction="#handleInfo" styleClass="toolbar-btn" />
                    <Button fx:id="addButton" onAction="#handleAdd" styleClass="toolbar-btn, primary-btn" />
                    <MenuButton fx:id="moreButton" styleClass="toolbar-btn" />
                </HBox>

                <TableView fx:id="tableView" styleClass="main-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" prefWidth="70" sortable="false">
                            <graphic>
                                <VBox alignment="TOP_CENTER" spacing="3.0" styleClass="col-head">
                                    <Label fx:id="idSortLabel" styleClass="sort-label" />
                                    <TextField fx:id="idFilter" styleClass="filter-field" />
                                </VBox>
                            </graphic>
                        </TableColumn>
                        <TableColumn fx:id="nameColumn" prefWidth="120" sortable="false">
                            <graphic>
                                <VBox alignment="TOP_CENTER" spacing="3.0" styleClass="col-head">
                                    <Label fx:id="nameSortLabel" styleClass="sort-label" />
                                    <TextField fx:id="nameFilter" styleClass="filter-field" />
                                </VBox>
                            </graphic>
                        </TableColumn>
                        <TableColumn fx:id="xCoordinateColumn" prefWidth="110" sortable="false">
                            <graphic>
                                <VBox alignment="TOP_CENTER" spacing="3.0" styleClass="col-head">
                                    <Label fx:id="xSortLabel" styleClass="sort-label" />
                                    <TextField fx:id="xFilter" styleClass="filter-field" />
                                </VBox>
                            </graphic>
                        </TableColumn>
                        <TableColumn fx:id="yCoordinateColumn" prefWidth="110" sortable="false">
                            <graphic>
                                <VBox alignment="TOP_CENTER" spacing="3.0" styleClass="col-head">
                                    <Label fx:id="ySortLabel" styleClass="sort-label" />
                                    <TextField fx:id="yFilter" styleClass="filter-field" />
                                </VBox>
                            </graphic>
                        </TableColumn>
                        <TableColumn fx:id="creationDateColumn" prefWidth="140" sortable="false">
                            <graphic>
                                <VBox alignment="TOP_CENTER" spacing="3.0" styleClass="col-head">
                                    <Label fx:id="dateSortLabel" styleClass="sort-label" />
                                    <TextField fx:id="dateFilter" styleClass="filter-field" />
                                </VBox>
                            </graphic>
                        </TableColumn>
                        <TableColumn fx:id="annualTurnoverColumn" prefWidth="120" sortable="false">
                            <graphic>
                                <VBox alignment="TOP_CENTER" spacing="3.0" styleClass="col-head">
                                    <Label fx:id="turnoverSortLabel" styleClass="sort-label" />
                                    <TextField fx:id="turnoverFilter" styleClass="filter-field" />
                                </VBox>
                            </graphic>
                        </TableColumn>
                        <TableColumn fx:id="fullNameColumn" prefWidth="130" sortable="false">
                            <graphic>
                                <VBox alignment="TOP_CENTER" spacing="3.0" styleClass="col-head">
                                    <Label fx:id="fullNameSortLabel" styleClass="sort-label" />
                                    <TextField fx:id="fullNameFilter" styleClass="filter-field" />
                                </VBox>
                            </graphic>
                        </TableColumn>
                        <TableColumn fx:id="typeColumn" prefWidth="120" sortable="false">
                            <graphic>
                                <VBox alignment="TOP_CENTER" spacing="3.0" styleClass="col-head">
                                    <Label fx:id="typeSortLabel" styleClass="sort-label" />
                                    <TextField fx:id="typeFilter" styleClass="filter-field" />
                                </VBox>
                            </graphic>
                        </TableColumn>
                        <TableColumn fx:id="addressColumn" prefWidth="120" sortable="false">
                            <graphic>
                                <VBox alignment="TOP_CENTER" spacing="3.0" styleClass="col-head">
                                    <Label fx:id="addressSortLabel" styleClass="sort-label" />
                                    <TextField fx:id="addressFilter" styleClass="filter-field" />
                                </VBox>
                            </graphic>
                        </TableColumn>
                        <TableColumn fx:id="ownerIdColumn" prefWidth="110" sortable="false">
                            <graphic>
                                <VBox alignment="TOP_CENTER" spacing="3.0" styleClass="col-head">
                                    <Label fx:id="ownerSortLabel" styleClass="sort-label" />
                                    <TextField fx:id="ownerFilter" styleClass="filter-field" />
                                </VBox>
                            </graphic>
                        </TableColumn>
                    </columns>
                </TableView>

                <Label fx:id="footerLabel" maxWidth="Infinity" styleClass="footer-label" />
            </VBox>
        </Tab>

        <Tab fx:id="visualizationTab">
            <StackPane fx:id="mapContainer" styleClass="map-container" />
        </Tab>

        <Tab fx:id="consoleTab">
            <VBox spacing="10.0" styleClass="console-pane">
                <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                <TextArea fx:id="consoleOutput" editable="false" styleClass="console-output" VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label fx:id="consolePromptLabel" styleClass="console-caret" text="&gt;" />
                    <TextField fx:id="consoleInput" onAction="#handleConsoleInput" styleClass="console-input" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
